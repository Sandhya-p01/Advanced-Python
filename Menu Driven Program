def sq():
    s=int(input("enter side: "))
    print("Area:",s*s)
def rect(l,b):
    print("Area: ",l*b)
def cir():
    r=int(input("enter radius: "))
    return 3.14*r*r
def tri(b,h):
    return 0.5*b*h
  
while True:
    print("1. Sqaure")
    print("2. Rectangle")
    print("3. Circle")
    print("4. Triangle")
    print("5. Exit")
    a=int(input("enter your choice: "))
    if a==1:
        sq()
    elif a==2:
        l=int(input("enter length: "))
        b=int(input("enter breadth: "))
        rect(l,b)
    elif a==3:
        x=cir()
        print("Area ",x)
    elif a==4:
        b=int(input("enter base: "))
        h=int(input("enter height: "))
        y=tri(b,h)
        print("Area: ",y)
    else:
        break
